GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Dashboard pipeline execution is disabled by default. If deliberately enabled,
# set a strong bearer token. Network scraping requires its own explicit opt-in.
BVMT_ENABLE_PIPELINE_API=false
BVMT_PIPELINE_API_TOKEN=
BVMT_ENABLE_NETWORK_SCRAPE=false
BVMT_CORS_ORIGINS=
HOST=127.0.0.1
